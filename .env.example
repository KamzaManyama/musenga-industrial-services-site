# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Gmail SMTP. Use a Google App Password (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password. App passwords need 2-Step Verification switched on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where enquiries are delivered (for now, your own inbox; later Musenga's, e.g. info@musenga.co.za).
ENQUIRY_TO=your.address@gmail.com
# Name shown as the sender in the inbox.
ENQUIRY_FROM_NAME=Musenga Website

# Send the visitor a confirmation email after they submit the form (true/false).
SEND_AUTO_REPLY=true
