---
// Fonts are served from this site (no requests to Google), so no visitor data goes to a third party.
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Animations from '../components/Animations.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set to false on pages without a contact section, so Contact links go to the home page form. */
  hasContact?: boolean;
  /** 'light' (default): dark header text over white page heroes. 'dark': white text over a dark hero (classic home hero). */
  headerTone?: 'dark' | 'light';
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Page without header, footer and back-to-top (e.g. the 404 page). */
  bare?: boolean;
}

const {
  hasContact = true,
  headerTone = 'light',
  noindex = false,
  bare = false,
  title = 'Musenga Investments',
  description = 'Musenga Investments provides waste management, cleaning and hygiene, and building construction and maintenance for public- and private-sector clients.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#202521">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
</head>
<body class="bg-white text-musenga-ink antialiased">
  <!-- Concept only: validate wording, services, credentials, projects and imagery with Musenga before publication. -->
  {!bare && <Header hasContact={hasContact} tone={headerTone} />}
  <main id="top">
    <slot />
  </main>
  {!bare && <Footer />}
  {!bare && <BackToTop />}
  <Animations />
</body>
</html>
