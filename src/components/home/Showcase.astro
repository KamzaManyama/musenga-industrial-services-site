---
import { images } from '../../data/images';
---
<!-- CINEMATIC THREE-PANEL SERVICE SHOWCASE (one panel per service, as on the live site) -->
<section id="services" aria-label="Our services" class="scroll-mt-20 w-full bg-[#1b1e1d]">

  <div id="showcase" class="relative">
    <div data-reveal-stagger class="grid grid-cols-2 lg:grid-cols-3">
      <a href="/services/cleaning-hygiene/" class="showcase-panel focus-ring group relative block h-[440px] overflow-hidden border-r border-white/10 sm:h-[580px] lg:h-[760px]" aria-label="Cleaning and hygiene services">
        <img class="absolute inset-0 h-full w-full object-cover object-center" src={images.cleaning.src} alt={images.cleaning.alt} loading="lazy">
        <span class="showcase-tint absolute inset-0 bg-[#1b1e1d]/45"></span>
        <span class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/50 to-transparent"></span>
        <span class="absolute left-5 top-6 text-[11px] font-semibold uppercase leading-[1.5] tracking-[.1em] text-white sm:left-7 sm:top-8 sm:text-[13px]">Cleaning &amp; Hygiene<br>Facilities Care</span>
        <span class="showcase-zoom" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 16l4 4M11 8v6M8 11h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <span class="absolute bottom-6 left-5 rotate-180 text-[8px] font-semibold uppercase tracking-[.35em] text-white/85 [writing-mode:vertical-rl] sm:bottom-8 sm:left-7">Facilities</span>
      </a>
      <a href="/services/building-maintenance/" class="showcase-panel focus-ring group relative block h-[440px] overflow-hidden border-white/10 sm:h-[580px] lg:h-[760px] lg:border-r" aria-label="Construction and maintenance services">
        <img class="absolute inset-0 h-full w-full object-cover object-center" src="/assets/stock/building-site-workers.jpg" alt="Two construction workers in hard hats on a building site, seen from above" loading="lazy">
        <span class="showcase-tint absolute inset-0 bg-[#1b1e1d]/45"></span>
        <span class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/50 to-transparent"></span>
        <span class="absolute left-5 top-6 text-[11px] font-semibold uppercase leading-[1.5] tracking-[.1em] text-white sm:left-7 sm:top-8 sm:text-[13px]">Construction<br>&amp; Maintenance</span>
        <span class="showcase-zoom" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 16l4 4M11 8v6M8 11h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <span class="absolute bottom-6 left-5 rotate-180 text-[8px] font-semibold uppercase tracking-[.35em] text-white/85 [writing-mode:vertical-rl] sm:bottom-8 sm:left-7">Built Environment</span>
      </a>
      <a href="/services/waste-management/" class="showcase-panel focus-ring group relative col-span-2 block h-[440px] overflow-hidden border-t border-white/10 sm:h-[580px] lg:col-span-1 lg:h-[760px] lg:border-t-0" aria-label="Waste management services">
        <img class="absolute inset-0 h-full w-full object-cover object-center" src="/assets/stock/waste-recycling-bales.jpg" alt="Bales of sorted plastic at a recycling site" loading="lazy">
        <span class="showcase-tint absolute inset-0 bg-[#1b1e1d]/45"></span>
        <span class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/50 to-transparent"></span>
        <span class="absolute left-5 top-6 text-[11px] font-semibold uppercase leading-[1.5] tracking-[.1em] text-white sm:left-7 sm:top-8 sm:text-[13px]">Waste Management<br>Responsible Disposal</span>
        <span class="showcase-zoom" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 16l4 4M11 8v6M8 11h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <span class="absolute bottom-6 left-5 rotate-180 text-[8px] font-semibold uppercase tracking-[.35em] text-white/85 [writing-mode:vertical-rl] sm:bottom-8 sm:left-7">Environment</span>
      </a>
    </div>
  </div>
</section>
