---
import { images } from '../../data/images';
---
<!-- CAPABILITIES / COMPLIANCE -->
<section id="capabilities" class="scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32 lg:px-14 lg:py-36">
  <div data-reveal-stagger class="mx-auto grid max-w-[1320px] grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-6">
      <div class="relative lg:h-full lg:min-h-[640px]">
        <img src={images.capability.src} alt={images.capability.alt} class="h-[460px] w-full object-cover sm:h-[600px] lg:absolute lg:inset-0 lg:h-full" loading="lazy">
        <div class="absolute -bottom-5 right-0 bg-musenga-green px-6 py-5 text-white sm:-right-5 sm:px-8 sm:py-7">
          <p class="text-[9px] font-bold uppercase tracking-[.18em] text-white/75">A considered approach</p>
          <p class="mt-2 max-w-[200px] text-lg font-semibold leading-snug">People, process and practical delivery.</p>
        </div>
      </div>
    </div>
    <div class="lg:col-span-5 lg:col-start-8 lg:self-center">
      <p class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-editorial text-musenga-green"><span class="h-px w-9 bg-musenga-green"></span> 03 / Capability &amp; trust</p>
      <h2 class="mt-7 text-3xl font-semibold leading-tight tracking-[-.04em] sm:text-5xl">Certified, registered and ready to deliver.</h2>
      <p class="mt-6 text-base leading-7 text-musenga-muted">Musenga works to recognised quality standards and holds the industry registrations that public- and private-sector buyers expect.</p>
      <div class="mt-9 divide-y divide-musenga-line border-y border-musenga-line">
        <div class="flex gap-5 py-5">
          <span class="w-5 shrink-0 text-xs font-semibold text-musenga-green">01</span>
          <div>
            <h3 class="text-sm font-bold">Quality certified</h3>
            <p class="mt-2 text-sm leading-6 text-musenga-muted">An ISO 9001:2015 quality management system across all three service divisions.</p>
          </div>
        </div>
        <div class="flex gap-5 py-5">
          <span class="w-5 shrink-0 text-xs font-semibold text-musenga-green">02</span>
          <div>
            <h3 class="text-sm font-bold">Industry registered</h3>
            <p class="mt-2 text-sm leading-6 text-musenga-muted">Registered with the relevant construction, cleaning and waste management industry bodies.</p>
          </div>
        </div>
        <div class="flex gap-5 py-5">
          <span class="w-5 shrink-0 text-xs font-semibold text-musenga-green">03</span>
          <div>
            <h3 class="text-sm font-bold">Tender ready</h3>
            <p class="mt-2 text-sm leading-6 text-musenga-muted">Compliance documentation in place for public- and private-sector procurement.</p>
          </div>
        </div>
      </div>
      <a href="/certifications/" class="btn btn-outline focus-ring mt-8">View our certifications <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
