---
const pillars = [
  { title: 'Skills transfer', text: 'Sharing knowledge and expertise so local teams grow with every project.' },
  { title: 'Capacity building', text: 'Strengthening businesses and communities to take on larger, more complex work.' },
  { title: 'Creating opportunity', text: 'Opening doors for previously disadvantaged individuals and communities.' },
];
---

<!-- PARTNERSHIPS -->
<section id="partnerships" class="scroll-mt-20 bg-musenga-mist px-5 py-20 sm:px-8 sm:py-24 lg:px-14 lg:py-28">
  <div data-reveal-stagger class="mx-auto grid max-w-[1320px] grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-editorial text-musenga-green"><span class="h-px w-9 bg-musenga-green"></span> 04 / Partnerships</p>
      <h2 class="mt-7 text-3xl font-semibold leading-tight tracking-[-.04em] sm:text-5xl">Stronger together.</h2>
      <p class="mt-6 text-base leading-7 text-musenga-muted">We pursue joint ventures with reputable organisations in government and the private sector, built on shared goals.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#contact" data-contact-service="Partnership or procurement enquiry" class="focus-ring inline-flex min-h-14 items-center justify-center gap-8 bg-musenga-green px-6 text-[11px] font-bold uppercase tracking-[.13em] text-white transition hover:bg-musenga-deep">
          Discuss a partnership <span aria-hidden="true">↗</span>
        </a>
        <a href="/about/#partnerships" class="focus-ring inline-flex min-h-14 items-center justify-center border border-musenga-ink px-6 text-[11px] font-bold uppercase tracking-[.13em] transition hover:bg-musenga-ink hover:text-white">
          Learn more
        </a>
      </div>
    </div>
    <ol class="divide-y divide-musenga-line border-y border-musenga-line lg:col-span-6 lg:col-start-7 lg:self-center">
      {pillars.map((pillar, i) => (
        <li class="flex gap-5 py-6">
          <span class="w-5 shrink-0 text-xs font-semibold text-musenga-green">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-lg font-semibold tracking-[-.02em]">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-6 text-musenga-muted">{pillar.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
