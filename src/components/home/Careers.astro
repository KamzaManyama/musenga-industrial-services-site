---
// "04 / Careers" on the home page: a short pitch plus the latest open roles, leading on to /careers/.
// Roles come from src/data/jobs.ts, so this stays in step with the Careers page automatically.
import { openJobs, formatDate } from '../../data/jobs';
import { company } from '../../data/company';

const roles = openJobs();
const latest = roles.slice(0, 3);
---

<!-- CAREERS -->
<section id="careers" class="scroll-mt-20 bg-musenga-mist px-5 py-24 sm:px-8 sm:py-32 lg:px-14 lg:py-36">
  <div data-reveal-stagger class="mx-auto grid max-w-[1320px] grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-editorial text-musenga-green"><span class="h-px w-9 bg-musenga-green"></span> 04 / Careers</p>
      <h2 class="mt-7 text-3xl font-semibold leading-tight tracking-[-.04em] sm:text-5xl">Local people. Real opportunities.</h2>
      <p class="mt-6 max-w-md text-base leading-7 text-musenga-muted">Wherever a project takes us, we look to employ residents from the surrounding community first, with work at every skill level across our three divisions.</p>
      <a href="/careers/" class="btn btn-solid focus-ring mt-9">
        {roles.length ? `View all ${roles.length} open roles` : 'Explore careers'} <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="lg:col-span-6 lg:col-start-7 lg:self-center">
      {latest.length ? (
        <>
          <p class="text-[10px] font-bold uppercase tracking-[.14em] text-musenga-muted">Latest openings</p>
          <ul class="mt-5 divide-y divide-musenga-line border-y border-musenga-line">
            {latest.map((job) => (
              <li>
                <a href={`/careers/${job.slug}/`} class="focus-ring group flex items-center gap-6 py-6">
                  <span class="flex-1">
                    <span class="block text-lg font-semibold tracking-[-.02em] transition group-hover:text-musenga-green">{job.title}</span>
                    <span class="mt-1 block text-sm text-musenga-muted">{job.division} · {job.location}</span>
                    <span class="mt-2 block text-[10px] font-bold uppercase tracking-[.14em] text-musenga-muted">{job.type} · Closes {formatDate(job.closingDate)}</span>
                  </span>
                  <span class="text-xl text-musenga-green transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="border-y border-musenga-line py-10">
          <h3 class="text-xl font-semibold tracking-[-.02em]">There are no open positions right now.</h3>
          <p class="mt-3 text-sm leading-6 text-musenga-muted">New roles are posted as projects start. Send your CV to <a href={`mailto:${company.careersEmail}`} class="font-semibold text-musenga-ink hover:text-musenga-green">{company.careersEmail}</a> for future opportunities.</p>
        </div>
      )}
    </div>
  </div>
</section>
