---
// Pages with a contact section keep "Contact" on the page; others send it to the home page form.
interface Props {
  hasContact?: boolean;
  /** 'light' = dark text while the header sits over a white hero (until the page scrolls). */
  tone?: 'dark' | 'light';
}
const { hasContact = true, tone = 'dark' } = Astro.props;
const contactHref = hasContact ? '#contact' : '/#contact';
const path = Astro.url.pathname;
const isHome = path === '/';
// The nav mirrors the home page sections, in page order. On the home page each item scrolls to its
// section (whose own button leads on to the full page). Elsewhere it opens the full page where one
// exists, or the home section where it doesn't. Careers has no home section, so it is always a page link.
// Contact is left out on purpose: the "Discuss an enquiry" button already covers it.
const links = [
  { label: 'About', section: 'about', page: '/about/', active: path.startsWith('/about') },
  { label: 'Who we serve', section: 'sectors', active: false },
  { label: 'Certifications', section: 'capabilities', page: '/certifications/', active: path.startsWith('/certifications') },
  { label: 'Services', section: 'services', active: path.startsWith('/services') },
  { label: 'Careers', page: '/careers/', active: path.startsWith('/careers') },
].map((link) => ({
  ...link,
  href: isHome && link.section ? `#${link.section}` : link.page ?? `/#${link.section}`,
}));
---

<header id="siteHeader" class:list={['site-header fixed inset-x-0 top-0 z-50 border-b border-[var(--hdr-line)] text-[var(--hdr-fg)]', tone === 'light' && 'on-light']}>
  <div class="header-inner mx-auto flex max-w-[1440px] items-center justify-between px-5 sm:px-8 lg:px-14">
    <a href="/" class="focus-ring flex items-center gap-3 rounded-sm" aria-label="Musenga Investments home">
      <img src="/assets/Musenga-Logo.png" alt="Musenga Investments" width="350" height="100" class="h-10 w-auto sm:h-11">
    </a>

    <nav class="hidden items-center gap-8 text-[11px] font-semibold uppercase tracking-[.14em] lg:flex" aria-label="Main navigation">
      {links.map((link) => (
        <a
          class:list={['focus-ring relative rounded-sm py-1 transition', link.active ? 'text-[var(--hdr-fg)] after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:bg-musenga-green' : 'text-[var(--hdr-muted)] hover:text-[var(--hdr-fg)]']}
          href={link.href}
          data-section={isHome ? link.section : undefined}
          aria-current={link.active ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <a href={contactHref} class="btn btn-sm focus-ring hidden border-[var(--hdr-border)] hover:border-musenga-green hover:bg-musenga-green hover:text-white sm:inline-flex">
      Discuss an enquiry <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
    <button id="menuButton" class="focus-ring rounded-sm border border-[var(--hdr-border)] p-2 lg:hidden" aria-label="Open navigation" aria-expanded="false" aria-controls="mobileMenu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
  </div>
  <nav id="mobileMenu" class="hidden border-t border-white/20 bg-musenga-ink/95 text-white px-5 py-5 sm:px-8 lg:hidden" aria-label="Mobile navigation">
    <div class="flex flex-col gap-5 text-xs font-semibold uppercase tracking-[.14em]">
      {links.map((link) => (
        <a href={link.href} class={link.active ? 'text-musenga-green' : ''} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
      ))}
      <!-- The header enquiry button is hidden on small phones, so it lives in the menu there. -->
      <a href={contactHref} class="text-musenga-green sm:hidden">Discuss an enquiry →</a>
    </div>
  </nav>
</header>

<script>
const header = document.getElementById('siteHeader')!;
const menuButton = document.getElementById('menuButton')!;
const mobileMenu = document.getElementById('mobileMenu')!;

// Give the header a solid background once the page scrolls past the top.
const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
window.addEventListener('scroll', updateHeader, { passive: true });
updateHeader();

menuButton.addEventListener('click', () => {
  const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
  menuButton.setAttribute('aria-expanded', String(!isOpen));
  menuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
  mobileMenu.classList.toggle('hidden', isOpen);
  header.classList.toggle('menu-open', !isOpen);
});
// On the home page, underline the nav item for the section currently in view.
const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]')];
const sections = sectionLinks
  .map(link => document.getElementById(link.dataset.section!))
  .filter((el): el is HTMLElement => el !== null);
if (sections.length) {
  const setActive = () => {
    const line = window.innerHeight * 0.35;
    let current: string | undefined;
    for (const el of sections) if (el.getBoundingClientRect().top <= line) current = el.id;
    // Past the end of the last nav section (e.g. in Contact), nothing is highlighted.
    const last = sections.find(el => el.id === current);
    if (last && last.getBoundingClientRect().bottom < line) current = undefined;
    for (const link of sectionLinks) link.classList.toggle('is-current', link.dataset.section === current);
  };
  window.addEventListener('scroll', setActive, { passive: true });
  setActive();
}

mobileMenu.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => {
    mobileMenu.classList.add('hidden');
    header.classList.remove('menu-open');
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Open navigation');
  });
});
</script>
