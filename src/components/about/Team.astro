---
// Team and portraits from Musenga's current website.
const team: { name: string; role: string; photo?: string }[] = [
  { name: 'Ntsumbeni Mavhungu', role: 'General Manager', photo: '/assets/team/ntsumbeni-mavhungu.jpg' },
  { name: 'Mpho Ramade', role: 'Operations Manager', photo: '/assets/team/mpho-ramade.jpg' },
  { name: 'Machume Happy Nhlangwini', role: 'SHEQ Manager', photo: '/assets/team/machume-happy-nhlangwini.jpg' },
  { name: 'Eluby Chilongozi', role: 'Tender Manager', photo: '/assets/team/eluby-chilongozi.jpg' },
  { name: 'Fulu Mnisi', role: 'Procurement Officer', photo: '/assets/team/fulu-mnisi.jpg' },
  { name: 'Vule Magavha', role: 'HR Manager', photo: '/assets/team/vule-magavha.jpg' },
];

const initials = (name: string) => {
  const parts = name.split(' ');
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
};
---

<section id="team" class="scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32 lg:px-14 lg:py-36">
  <div class="mx-auto max-w-[1320px]">
    <div data-reveal-stagger class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-editorial text-musenga-green"><span class="h-px w-9 bg-musenga-green"></span> 03 / Our team</p>
        <h2 class="mt-7 max-w-2xl text-3xl font-semibold leading-tight tracking-[-.04em] sm:text-5xl">The people behind the work.</h2>
      </div>
      <p class="max-w-md text-base leading-7 text-musenga-muted md:col-span-5 md:justify-self-end">A management team covering operations, safety and quality, tenders, procurement and people. We value working together.</p>
    </div>

    <ul data-reveal-stagger class="mt-14 grid grid-cols-2 gap-5 md:grid-cols-3">
      {team.map((person) => (
        <li class="group bg-musenga-mist">
          <div class="relative aspect-[4/5] overflow-hidden bg-musenga-line">
            {person.photo ? (
              <img src={person.photo} alt={`${person.name}, ${person.role}`} class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.03]" loading="lazy">
            ) : (
              <span class="display flex h-full w-full items-center justify-center text-4xl font-semibold tracking-[-.03em] text-musenga-muted/60 sm:text-5xl" aria-hidden="true">{initials(person.name)}</span>
            )}
          </div>
          <div class="p-5 sm:p-6">
            <h3 class="text-base font-semibold tracking-[-.02em] sm:text-lg">{person.name}</h3>
            <p class="mt-1 text-[10px] font-bold uppercase tracking-[.14em] text-musenga-green">{person.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
