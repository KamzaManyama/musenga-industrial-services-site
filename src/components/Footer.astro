---
import { company } from '../data/company';
---

<footer class="bg-musenga-ink px-5 pt-16 text-white sm:px-8 lg:px-14 lg:pt-20">
  <div class="mx-auto grid max-w-[1320px] grid-cols-1 gap-12 pb-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <a href="/" class="focus-ring inline-flex w-fit items-center gap-3 rounded-sm" aria-label="Musenga Investments home">
        <span class="bg-white px-4 py-3"><img src="/assets/Musenga-Logo.png" alt="Musenga Investments" width="350" height="100" class="h-10 w-auto"></span>
      </a>
      <p class="mt-6 max-w-xs text-sm leading-6 text-white/60">A 100% Black woman-owned company providing waste management, cleaning and hygiene, and building construction and maintenance since 2002.</p>
      <!-- Social links: replace "#" with Musenga's real profile URLs before launch. -->
      <div class="mt-7 flex gap-2">
        <a href="#" class="focus-ring flex h-9 w-9 items-center justify-center border border-white/25 text-white/75 transition hover:border-musenga-green hover:bg-musenga-green hover:text-white" aria-label="Musenga on Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 8h2.5V4.5H14c-2.5 0-4 1.6-4 4V11H7.5v3.5H10V20h3.5v-5.5H16l.5-3.5h-3V8.7c0-.4.2-.7.5-.7z" fill="currentColor"/></svg></a>
        <a href="#" class="focus-ring flex h-9 w-9 items-center justify-center border border-white/25 text-white/75 transition hover:border-musenga-green hover:bg-musenga-green hover:text-white" aria-label="Musenga on Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6"/><circle cx="16.8" cy="7.2" r="1" fill="currentColor"/></svg></a>
        <a href="#" class="focus-ring flex h-9 w-9 items-center justify-center border border-white/25 text-white/75 transition hover:border-musenga-green hover:bg-musenga-green hover:text-white" aria-label="Musenga on YouTube"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 9.5v5l4.2-2.5-4.2-2.5z" fill="currentColor"/></svg></a>
        <a href="#" class="focus-ring flex h-9 w-9 items-center justify-center border border-white/25 text-white/75 transition hover:border-musenga-green hover:bg-musenga-green hover:text-white" aria-label="Musenga on X"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4.5h3.6l10.4 15H15.4L5 4.5zM18.6 4.5L13.3 10.6M5.4 19.5l5.4-6.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></a>
      </div>
    </div>
    <nav class="lg:col-span-2 lg:col-start-6" aria-label="Footer services">
      <p class="text-[10px] font-bold uppercase tracking-[.16em] text-white/50">Services</p>
      <ul class="mt-5 space-y-3">
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/services/waste-management/">Waste management</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/services/cleaning-hygiene/">Cleaning &amp; hygiene</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/services/building-maintenance/">Building &amp; maintenance</a></li>
      </ul>
    </nav>
    <nav class="lg:col-span-2" aria-label="Footer company">
      <p class="text-[10px] font-bold uppercase tracking-[.16em] text-white/50">Company</p>
      <ul class="mt-5 space-y-3">
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/about/">About us</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/certifications/">Certifications</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/about/#partnerships">Partnerships</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/careers/">Careers</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="/#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="lg:col-span-3">
      <p class="text-[10px] font-bold uppercase tracking-[.16em] text-white/50">Get in touch</p>
      <ul class="mt-5 space-y-3 text-sm leading-6 text-white/80">
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="tel:+27110243412">+27 11 024 3412</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="mailto:info@musenga.co.za">info@musenga.co.za</a></li>
        <li><a class="focus-ring rounded-sm text-sm text-white/80 transition hover:text-white" href="https://www.google.com/maps/search/?api=1&amp;query=64+Dane+Road,+Glen+Austin,+Midrand" target="_blank" rel="noopener">64 Dane Road, Glen Austin,<br>Midrand, South Africa</a></li>
        <li class="text-white/60">Mon – Fri · 08:00 – 17:00</li>
      </ul>
    </div>
  </div>
  <div class="mx-auto flex max-w-[1320px] flex-col gap-4 border-t border-white/15 py-7 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-xs leading-5 text-white/50">
      <p>© <span id="year">2026</span> {company.legalName}. All rights reserved.</p>
      <p class="mt-1">
        Reg. no. {company.registrationNumber ?? 'to be confirmed'}{company.vatNumber && <span> · VAT no. {company.vatNumber}</span>}
        <span class="mx-2 text-white/25">|</span>
        <a href="/privacy/" class="focus-ring rounded-sm text-white/70 underline-offset-4 transition hover:text-white hover:underline">Privacy policy</a>
      </p>
    </div>
    <p class="text-xs leading-5 text-white/35">Website concept for discussion · Not an approved or published company website.</p>
  </div>
</footer>

<script>
document.getElementById('year').textContent = String(new Date().getFullYear());
</script>
